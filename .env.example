# install.sh creates .env.local from this file. Add your JEV key:
TYPESAFE_API_KEY=

# Claude/Codex reuse your local CLI login. Alternatively, set provider API keys:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# DeepSeek Harness uses an API key (OAuth is not integrated):
# DEEPSEEK_API_KEY=
# Optional main-model override; DeepSeek Flash supports image-based review:
# VIDEO_DEEPSEEK_MODEL=deepseek-flash

# Gemini supports two transports (auto-selected):
# - Without GEMINI_API_KEY / Vertex env vars: uses installed `agy` CLI (your Antigravity login).
# - With GEMINI_API_KEY / Vertex env vars: uses the Antigravity Python SDK bridge (`npm run gemini:setup`).
# GEMINI_API_KEY=
# Optional main-model override (gemini-4-neon or gemini-4-carbon):
# VIDEO_GEMINI_MODEL=gemini-4-neon
# Optional transport override: auto (default), cli, or sdk
# VIDEO_GEMINI_TRANSPORT=auto
# Optional executable overrides:
# VIDEO_GEMINI_AGY_BIN=
# VIDEO_GEMINI_PYTHON=

# Ports, models and installed local tools use app defaults; no paths are needed.
# Advanced settings: docs/application-guide.md
# Recording/worker overrides: docs/openscreen-worker.md
# Audio Studio overrides: src/server/agents/capabilities/README.md
